<?xml version="1.0" encoding="utf-8"?>
<!-- Test-only stand-in for the launcher's theme provider: serves one Riposte row on the
     release authority so the suite's runtime styling can be exercised on an emulator
     with no launcher installed. Never ship this. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ripostelabs.themestub"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="33" />
    <application android:label="ThemeStub">
        <provider
            android:name="com.ripostelabs.themestub.StubProvider"
            android:authorities="com.ripostelabs.carlauncher.theme"
            android:exported="true" />
    </application>
</manifest>
