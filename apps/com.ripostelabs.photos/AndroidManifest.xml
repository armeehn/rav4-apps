<?xml version="1.0" encoding="utf-8"?>
<!-- Clean-room replacement for the GT6 built-in image viewer (com.szchoiceway.photoreader),
     which shipped labelled "XDemonstrate". Same package + entry activity so a Magisk
     systemless overlay drops it into the OEM's slot. Pure UI, no vehicle/VHAL calls. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ripostelabs.photos"
    android:versionCode="1"
    android:versionName="1.0-riposte">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="33" />


    <!-- The launcher's theme provider (see com.ripostelabs.design.Palette). Without this an app
         targeting API 30+ cannot see the provider at all: the query returns null and the app
         silently keeps its built-in palette. Declaring the authority is the whole grant. -->
    <queries>
        <provider android:authorities="com.ripostelabs.carlauncher.theme" />
    </queries>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <!-- keep the OEM entry component name so explicit launches still resolve -->
        <activity
            android:name="com.szchoiceway.photoreader.activity.RunActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.szchoiceway.photoreader.activity.ViewerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
