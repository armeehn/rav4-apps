<?xml version="1.0" encoding="utf-8"?>
<!-- Master-detail: notes list (~40%) on the left, editor (~60%) on the right.
     Tuned for the 1920x720 GT6 landscape head unit. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg">

    <!-- ================= LEFT: master list ================= -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.40"
        android:orientation="vertical"
        android:background="@color/bg2"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="0dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/H1"
                    android:text="@string/app_name" />

                <TextView
                    android:id="@+id/count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    style="@style/Caption"
                    android:text="" />
            </LinearLayout>
        </LinearLayout>

        <!-- Search field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_field"
            android:paddingLeft="14dp"
            android:paddingRight="10dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:tint="@color/text3" />

            <EditText
                android:id="@+id/search"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:background="@android:color/transparent"
                android:hint="@string/search_hint"
                android:textColorHint="@color/text3"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:singleLine="true"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:inputType="text" />
        </LinearLayout>

        <!-- List + empty state + FAB -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:scrollbarStyle="outsideOverlay"
                android:clipToPadding="false"
                android:paddingTop="2dp"
                android:paddingBottom="96dp" />

            <!-- Empty state: the shared shape (styles.xml EmptyState*), ids stay ours. -->
            <LinearLayout
                android:id="@+id/empty"
                style="@style/EmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    style="@style/EmptyStateIcon"
                    android:src="@drawable/ic_edit" />

                <TextView
                    android:id="@+id/empty_title"
                    style="@style/EmptyStateTitle"
                    android:text="@string/empty_title" />

                <TextView
                    android:id="@+id/empty_hint"
                    style="@style/EmptyStateHint"
                    android:text="@string/empty_hint" />
            </LinearLayout>

            <!-- FAB -->
            <ImageButton
                android:id="@+id/btn_fab"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="bottom|right"
                android:layout_marginBottom="22dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/btn_fab"
                android:src="@drawable/ic_add"
                android:tint="#FFFFFFFF"
                android:scaleType="fitCenter"
                android:padding="16dp"
                android:elevation="6dp"
                android:contentDescription="@string/new_note" />
        </FrameLayout>
    </LinearLayout>

    <!-- ================= RIGHT: detail / editor ================= -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.60"
        android:background="@color/bg">

        <!-- Editor -->
        <LinearLayout
            android:id="@+id/editor_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingTop="18dp"
            android:paddingBottom="20dp"
            android:visibility="gone">

            <!-- Toolbar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/editor_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Overline"
                    android:text="" />

                <ImageButton
                    android:id="@+id/btn_delete"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/btn_icon"
                    android:src="@drawable/ic_delete"
                    android:tint="@color/text2"
                    android:scaleType="fitCenter"
                    android:padding="12dp"
                    android:contentDescription="@string/delete" />

                <ImageButton
                    android:id="@+id/btn_save"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/btn_icon"
                    android:src="@drawable/ic_save"
                    android:tint="@color/accent"
                    android:scaleType="fitCenter"
                    android:padding="12dp"
                    android:contentDescription="@string/save" />
            </LinearLayout>

            <!-- Editor surface -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:padding="6dp">

                <EditText
                    android:id="@+id/editor"
                    android:imeOptions="flagNoExtractUi"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:padding="18dp"
                    android:hint="@string/editor_hint"
                    android:textColorHint="@color/text3"
                    android:textColor="@color/text"
                    android:textSize="19sp"
                    android:lineSpacingExtra="4dp"
                    android:inputType="textMultiLine|textCapSentences"
                    android:gravity="top"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="false" />
            </FrameLayout>
        </LinearLayout>

        <!-- Detail empty state -->
        <LinearLayout
            android:id="@+id/detail_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:src="@drawable/ic_edit"
                android:tint="@color/text3"
                android:alpha="0.6" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                style="@style/H1"
                android:text="@string/detail_empty_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                style="@style/Caption"
                android:text="@string/detail_empty_hint" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
