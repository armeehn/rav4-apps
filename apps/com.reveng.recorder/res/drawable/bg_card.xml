<?xml version="1.0" encoding="utf-8"?>
<!-- v0.8 Riposte: hard edges — a 2dp structural border over a 4dp x 4dp unblurred
     offset shadow. Drawn, not lit: the shadow is a plain rectangle behind the body. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/shadow" />
        </shape>
    </item>
    <item android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="2dp" android:color="@color/stroke" />
        </shape>
    </item>
</layer-list>
