<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginRight="14dp"
            android:src="@drawable/ic_movie"
            android:tint="@color/accent"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/header_title"
                style="@style/H1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/header_title" />
            <TextView
                android:id="@+id/count"
                style="@style/Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <!-- Empty state: the shared shape (styles.xml EmptyState*), ids stay ours. -->
        <LinearLayout
            android:id="@+id/empty"
            style="@style/EmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                style="@style/EmptyStateIcon"
                android:src="@drawable/ic_movie"
                android:contentDescription="@string/empty_no_videos" />
            <TextView
                android:id="@+id/empty_text"
                style="@style/EmptyStateTitle"
                android:text="@string/empty_no_videos" />
            <TextView
                android:id="@+id/empty_hint"
                style="@style/EmptyStateHint"
                android:text="@string/empty_hint" />
            <Button
                android:id="@+id/grant"
                style="@style/EmptyStateAction"
                android:text="@string/grant" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
