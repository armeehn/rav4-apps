<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <VideoView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Handbrake gate (see BrakeGate). Opaque cover over the surface while the MCU
         says the brake is off; audio keeps playing underneath. Clickable so a tap
         does not reach the VideoView's controller toggle. -->
    <TextView
        android:id="@+id/brake_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:clickable="true"
        android:textSize="28sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text2"
        android:background="@color/bg"
        android:visibility="gone"
        android:text="@string/brake_required" />

    <!-- Top scrim for the back affordance -->
    <View
        android:id="@+id/top_scrim"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_gravity="top"
        android:background="@drawable/scrim_top" />

    <ImageButton
        android:id="@+id/back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|left"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back"
        android:tint="#FFFFFFFF"
        android:background="@drawable/btn_icon"
        android:contentDescription="@string/app_name" />
</FrameLayout>
