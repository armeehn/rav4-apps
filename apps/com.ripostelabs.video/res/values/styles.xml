<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <!-- The launcher hides the system bars; an app that does not flashes the clock and
             battery in and out on every launch (UI audit, 2026-09-22). -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
    </style>
    <style name="Display">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">64sp</item>
        <item name="android:fontFamily">sans-serif-thin</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="H1">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="H2">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Body">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Caption">
        <item name="android:textColor">@color/text2</item>
        <item name="android:textSize">13sp</item>
    </style>
    <!-- Empty state (Track D, RAV4-66): one look for "nothing here yet" across the suite.
         Container, icon, title, hint, action; ids stay the app's own (empty, empty_icon,
         empty_text / empty_title, empty_hint, grant), the attributes come from here.
         Flat names on purpose: a dotted child would inherit the container's padding. -->
    <style name="EmptyState">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">32dp</item>
        <item name="android:paddingRight">32dp</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="EmptyStateIcon">
        <item name="android:layout_width">96dp</item>
        <item name="android:layout_height">96dp</item>
        <item name="android:tint">@color/text3</item>
        <item name="android:alpha">0.7</item>
    </style>
    <style name="EmptyStateTitle" parent="H2">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="EmptyStateHint" parent="Caption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:gravity">center</item>
    </style>
    <!-- The ghost button the video app drew by hand: AppTheme sets no buttonStyle, so a bare
         <Button> is the platform's grey one. The look lives here so every app's grant matches. -->
    <style name="EmptyStateAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">28dp</item>
        <item name="android:paddingRight">28dp</item>
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:visibility">gone</item>
    </style>
    <!-- Media seek bar (UI audit, 2026-09-22): a 24 px thumb on a 1920 px panel is not
         hittable while driving. The view is 48 dp tall so the whole row is the touch target,
         the track is 12 dp so the eye finds it, and the thumb is a 28 dp disc.

           [.............. 48 dp touch target ..............]
           [    (o)==========:::::::::::::::::::::::        ]
           [   28 dp thumb        12 dp track               ]
    -->
    <style name="SeekControl">
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">12dp</item>
        <item name="android:maxHeight">12dp</item>
        <item name="android:progressDrawable">@drawable/seek_track</item>
        <item name="android:thumb">@drawable/seek_thumb</item>
        <item name="android:splitTrack">false</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
    </style>
    <style name="Overline">
        <item name="android:textColor">@color/text3</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
