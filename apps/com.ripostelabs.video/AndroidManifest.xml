<?xml version="1.0" encoding="utf-8"?>
<!-- Clean-room standalone replacement for the OEM GT6 video player
     (com.szchoiceway.videoplayer, labelled "HD movies"). Standalone normal
     app: own package, no sharedUserId, no privileged perms. Pure android.* -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ripostelabs.video"
    android:versionCode="1"
    android:versionName="1.0-riposte">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="33" />


    <!-- The launcher's theme provider (see com.ripostelabs.design.Palette). Without this an app
         targeting API 30+ cannot see the provider at all: the query returns null and the app
         silently keeps its built-in palette. Declaring the authority is the whole grant. -->
    <queries>
        <provider android:authorities="com.ripostelabs.carlauncher.theme" />
    </queries>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="com.ripostelabs.video.ListActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.ripostelabs.video.PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
