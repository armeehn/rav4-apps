<?xml version="1.0" encoding="utf-8"?>
<!-- Clean-room replacement for the GT6 built-in Bluetooth manager
     (com.szchoiceway.btsuite), which shipped labelled "Bluetooth".
     Standalone normal app: no sharedUserId, no platform signing, no system perms.
     BLUETOOTH_CONNECT / BLUETOOTH_SCAN are normal runtime perms on API 31+. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.reveng.bluetooth"
    android:versionCode="1"
    android:versionName="1.0-reveng">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="33" />


    <!-- The launcher's theme provider (see com.reveng.design.Palette). Without this an app
         targeting API 30+ cannot see the provider at all: the query returns null and the app
         silently keeps its built-in palette. Declaring the authority is the whole grant. -->
    <queries>
        <provider android:authorities="com.reveng.carlauncher.theme" />
    </queries>
    <!-- Legacy blanket perms (auto-granted) for API <= 30 -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- API 31+ runtime perms. neverForLocation lets us scan without location. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Location for classic discovery on API <= 30 (needed for ACTION_FOUND) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="com.reveng.bluetooth.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
