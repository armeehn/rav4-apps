<?xml version="1.0" encoding="utf-8"?>
<!-- Clean-room radio for the GT6 head unit. FM/AM tuner driven through whichever
     process owns the MCU link: the vendor event gateway (com.szchoiceway.eventcenter,
     VendorTuner) or on Riposte OS 0.2 the launcher's ITuner (LauncherTuner), both via
     hand-rolled Binder proxies — see Tuner.java — plus internet streaming
     (android.media.MediaPlayer) on a NET tab.
     Standalone normal app: no sharedUserId, no platform signing, no system perms. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ripostelabs.radio"
    android:versionCode="3"
    android:versionName="2.1-riposte">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="33" />


    <!-- The launcher's theme provider (see com.ripostelabs.design.Palette). Without this an app
         targeting API 30+ cannot see the provider at all: the query returns null and the app
         silently keeps its built-in palette. Declaring the authority is the whole grant. -->
    <queries>
        <provider android:authorities="com.ripostelabs.carlauncher.theme" />
        <!-- The launcher's ITuner on 0.2 (release, then the farm's debug build): without the
             package here, bindService() on API 30+ cannot see the service at all. -->
        <package android:name="com.ripostelabs.carlauncher" />
        <package android:name="com.ripostelabs.carlauncher.debug" />
    </queries>
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="com.ripostelabs.radio.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
