<?xml version="1.0" encoding="utf-8"?>
<!-- Microphone settings: the CarPlay mic's pickup, the echo canceller's and the noise suppressor's switches, strength and model.
     Opened from the Projection screen's Mic button and from the launcher's phone settings. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <TextView
            style="@style/H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mic_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/mic_intro"
            android:textColor="@color/text2"
            android:textSize="15sp" />

        <TextView
            style="@style/H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/mic_pickup" />

        <RadioGroup
            android:id="@+id/pickup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/pickup_direct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="@string/mic_pickup_direct"
                android:textColor="@color/text" />

            <RadioButton
                android:id="@+id/pickup_recognition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="@string/mic_pickup_recognition"
                android:textColor="@color/text" />

            <RadioButton
                android:id="@+id/pickup_unprocessed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="@string/mic_pickup_unprocessed"
                android:textColor="@color/text" />

            <RadioButton
                android:id="@+id/pickup_platform"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="@string/mic_pickup_platform"
                android:textColor="@color/text" />
        </RadioGroup>

        <Button
            android:id="@+id/probe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="56dp"
            android:text="@string/probe_button" />

        <TextView
            android:id="@+id/probe_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/probe_idle"
            android:textColor="@color/text2"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/aec_carplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="56dp"
            android:text="@string/mic_aec_carplay"
            android:textColor="@color/text"
            android:textSize="17sp" />

        <Switch
            android:id="@+id/ns_carplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="56dp"
            android:text="@string/mic_ns_carplay"
            android:textColor="@color/text"
            android:textSize="17sp" />

        <TextView
            style="@style/H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/mic_strength" />

        <RadioGroup
            android:id="@+id/strength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/strength_light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="48dp"
                android:minHeight="56dp"
                android:text="@string/mic_strength_light"
                android:textColor="@color/text" />

            <RadioButton
                android:id="@+id/strength_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="48dp"
                android:minHeight="56dp"
                android:text="@string/mic_strength_medium"
                android:textColor="@color/text" />

            <RadioButton
                android:id="@+id/strength_full"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="48dp"
                android:minHeight="56dp"
                android:text="@string/mic_strength_full"
                android:textColor="@color/text" />
        </RadioGroup>

        <TextView
            style="@style/H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/mic_model" />

        <RadioGroup
            android:id="@+id/model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/model_auto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="48dp"
                android:minHeight="56dp"
                android:text="@string/mic_model_auto"
                android:textColor="@color/text" />

            <RadioButton
                android:id="@+id/model_standard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="48dp"
                android:minHeight="56dp"
                android:text="@string/mic_model_standard"
                android:textColor="@color/text" />

            <RadioButton
                android:id="@+id/model_car"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="48dp"
                android:minHeight="56dp"
                android:text="@string/mic_model_car"
                android:textColor="@color/text" />
        </RadioGroup>

        <TextView
            android:id="@+id/model_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/jetbrains_mono"
            android:textColor="@color/text2"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/engine_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/jetbrains_mono"
            android:textColor="@color/text2"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/mic_applies"
            android:textColor="@color/text3"
            android:textSize="14sp" />
        <TextView
            style="@style/H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/callcheck_title" />

        <Button
            android:id="@+id/callcheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="56dp"
            android:text="@string/callcheck_button" />

        <TextView
            android:id="@+id/callcheck_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/jetbrains_mono"
            android:text="@string/callcheck_idle"
            android:textColor="@color/text2"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
