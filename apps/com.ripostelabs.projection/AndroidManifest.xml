<?xml version="1.0" encoding="utf-8"?>
<!-- Clean-room replacement for the OEM Zlink projection app. Stage 1: a wired Android Auto
     receiver. Stage 2: the wireless bootstrap (Bluetooth RFCOMM, then a local-only hotspot and
     a TCP socket). Standalone normal app: new package, no sharedUserId, no system permissions.
     Pure android.* framework; the protocol is hand-written Java under src/.../aa. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ripostelabs.projection"
    android:versionCode="2"
    android:versionName="0.2-stage2">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="33" />

    <!-- Not required: the emulator farm has no USB host and must still install the APK for a
         launch smoke. The activity says so on screen instead. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- Stage 2. Bluetooth: the RFCOMM server needs BLUETOOTH_CONNECT on API 31+ (the legacy
         pair below covers API 30 and under); ADVERTISE is for making the unit discoverable.
         Hotspot: startLocalOnlyHotspot checks CHANGE_WIFI_STATE plus NEARBY_WIFI_DEVICES on
         API 33 (FINE_LOCATION before that). The TCP server needs INTERNET. None of these is a
         system permission; the tethering path in SoftAp (flag off) would need
         TETHER_PRIVILEGED, i.e. the priv-app build on Riposte OS 0.2. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Riposte OS 0.2 CarPlay: the OEM daemon dials four localhost servers this app runs from
         boot, so the service is foreground and starts on BOOT_COMPLETED. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <!-- The launcher's theme provider (see com.ripostelabs.design.Palette). Without this an app
         targeting API 30+ cannot see the provider at all: the query returns null and the app
         silently keeps its built-in palette. Declaring the authority is the whole grant. -->
    <queries>
        <provider android:authorities="com.ripostelabs.carlauncher.theme" />
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="com.ripostelabs.projection.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The system launches us, permission pre-granted, when a phone in accessory mode
                 (Google VID) appears. A phone still in MTP mode is switched from the Connect
                 button and then re-attaches as one of these. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>
        <!-- CarPlay on Riposte OS 0.2 through the OEM daemon (see zlink/Fox.java). -->
        <activity
            android:name="com.ripostelabs.projection.CarPlayActivity"
            android:exported="true"
            android:label="@string/carplay_name"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="com.ripostelabs.projection.ZlinkService"
            android:exported="false" />
        <receiver
            android:name="com.ripostelabs.projection.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
