<?xml version="1.0" encoding="utf-8"?>
<!-- Clean-room standalone Compass app for the Toyota RAV4 GT6 head unit.
     Standalone normal app: new package, no sharedUserId, no permissions.
     Orientation is read entirely from on-device motion sensors (SensorManager);
     nothing is networked and no runtime permission is required. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.reveng.compass"
    android:versionCode="1"
    android:versionName="1.0-reveng">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="33" />

    <!-- Declared so the app surfaces to systems that filter on features, but not
         required: a device without a compass still runs and shows a message. -->
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="com.reveng.compass.CompassActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
