<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg"
    android:padding="24dp">

    <!-- ===== LEFT: brand strip + lamp picker ===== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="24"
        android:orientation="vertical"
        android:background="@drawable/bg_card_grad"
        android:padding="24dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_lamp"
            android:tint="@color/accent" />

        <TextView
            style="@style/Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name" />

        <TextView
            style="@style/H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/subtitle" />

        <!-- Link status chip -->
        <LinearLayout
            android:id="@+id/statusChip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:background="@drawable/bg_field"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">
            <TextView
                android:id="@+id/status"
                style="@style/H2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/idle" />
            <TextView
                android:id="@+id/statusDetail"
                style="@style/Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Lamps found by the last scan; one row each, tap to connect -->
        <LinearLayout
            android:id="@+id/deviceList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <TextView
            style="@style/Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/scan_hint" />

        <TextView
            android:id="@+id/scanBtn"
            style="@style/H2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_ghost"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:textColor="@color/accent"
            android:text="@string/scan" />
    </LinearLayout>

    <!-- ===== CENTRE: power + colour + brightness ===== -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="44"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical">

        <!-- Power: one large target, accent when on -->
        <TextView
            android:id="@+id/powerBtn"
            style="@style/H1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_ghost"
            android:gravity="center"
            android:paddingTop="22dp"
            android:paddingBottom="22dp"
            android:text="@string/off" />

        <TextView
            style="@style/Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/colour" />

        <com.ripostelabs.lamp.HueBar
            android:id="@+id/hue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp" />

        <!-- Preset swatches, filled in code -->
        <LinearLayout
            android:id="@+id/swatches"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">
            <TextView
                style="@style/Overline"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/brightness" />
            <TextView
                android:id="@+id/brightnessValue"
                style="@style/Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/brightness"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />
    </LinearLayout>

    <!-- ===== RIGHT: effects, speed, music ===== -->
    <LinearLayout
        android:id="@+id/effectsPanel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="32"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="24dp">

        <TextView
            style="@style/Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/effects" />

        <!-- Effect stepper: ◀  name  ▶ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/effectPrev"
                android:contentDescription="@string/prev_effect"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/btn_icon"
                android:padding="16dp"
                android:src="@drawable/ic_prev"
                android:tint="@color/text" />
            <TextView
                android:id="@+id/effectName"
                style="@style/H2"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/auto" />
            <ImageView
                android:id="@+id/effectNext"
                android:contentDescription="@string/next_effect"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/btn_icon"
                android:padding="16dp"
                android:src="@drawable/ic_next"
                android:tint="@color/text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">
            <TextView
                style="@style/Overline"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/speed" />
            <TextView
                android:id="@+id/speedValue"
                style="@style/Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/speed"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    style="@style/Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/music" />
                <TextView
                    style="@style/Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/music_hint" />
            </LinearLayout>
            <Switch
                android:id="@+id/music"
                android:contentDescription="@string/music"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">
            <TextView
                style="@style/Overline"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/sensitivity" />
            <TextView
                android:id="@+id/gainValue"
                style="@style/Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/gain"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />
    </LinearLayout>
</LinearLayout>
