<?xml version="1.0" encoding="utf-8"?>
<!-- Clean-room standalone Sound Meter (dB SPL meter) for the Toyota RAV4 GT6 head unit.
     Standalone normal app: new package, no sharedUserId, no platform signing.
     Samples the microphone amplitude via android.media.MediaRecorder and renders an
     approximate dB SPL level on a custom Canvas gauge. Pure android.*, no AndroidX. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.reveng.soundmeter"
    android:versionCode="1"
    android:versionName="1.0-reveng">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="33" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Declared but not required: the app still launches without a mic and shows
         a graceful message rather than filtering itself out of the launcher. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="com.reveng.soundmeter.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
