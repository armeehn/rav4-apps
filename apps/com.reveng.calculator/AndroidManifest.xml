<?xml version="1.0" encoding="utf-8"?>
<!-- Clean-room standalone Calculator for the GT6 head unit. Standalone normal app:
     new package, no sharedUserId, no system/privileged permissions, no internet.
     Pure android.* framework; expression engine is a hand-written recursive-descent
     parser (no ScriptEngine / JS). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.reveng.calculator"
    android:versionCode="1"
    android:versionName="1.0-reveng">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="33" />


    <!-- The launcher's theme provider (see com.reveng.design.Palette). Without this an app
         targeting API 30+ cannot see the provider at all: the query returns null and the app
         silently keeps its built-in palette. Declaring the authority is the whole grant. -->
    <queries>
        <provider android:authorities="com.reveng.carlauncher.theme" />
    </queries>
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="com.reveng.calculator.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
