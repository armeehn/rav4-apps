<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg"
    android:padding="20dp">

    <!-- ===== LEFT: converter card ===== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="46"
        android:orientation="vertical"
        android:background="@drawable/bg_card_grad"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_dollar"
                android:tint="@color/accent" />

            <TextView
                style="@style/H1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/convert" />

            <TextView
                android:id="@+id/status"
                style="@style/Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text3"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- FROM -->
        <TextView
            style="@style/Overline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/from_label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/amount"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:background="@drawable/bg_field"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text3"
                android:textSize="30sp"
                android:fontFamily="@font/jetbrains_mono"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:gravity="center_vertical"
                android:hint="@string/amount_hint" />

            <Spinner
                android:id="@+id/fromSpinner"
                android:layout_width="150dp"
                android:layout_height="64dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_field"
                android:paddingLeft="8dp"
                android:paddingRight="8dp" />
        </LinearLayout>

        <!-- swap -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/stroke" />

            <ImageButton
                android:id="@+id/swapBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="14dp"
                android:background="@drawable/btn_icon"
                android:src="@drawable/ic_swap"
                android:scaleType="centerInside"
                android:tint="@color/accent"
                android:contentDescription="@string/swap" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/stroke" />
        </LinearLayout>

        <!-- TO -->
        <TextView
            style="@style/Overline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/to_label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/result"
                style="@style/Display"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="44sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="0.00" />

            <Spinner
                android:id="@+id/toSpinner"
                android:layout_width="150dp"
                android:layout_height="64dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_field"
                android:paddingLeft="8dp"
                android:paddingRight="8dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- rate line + updated -->
        <TextView
            android:id="@+id/rateLine"
            style="@style/Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text"
            android:text="—" />

        <TextView
            android:id="@+id/updated"
            style="@style/Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text3"
            android:text="@string/source" />
    </LinearLayout>

    <!-- ===== RIGHT: live rates board ===== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="54"
        android:layout_marginStart="20dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                style="@style/Overline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/live_rates" />

            <ImageButton
                android:id="@+id/refreshBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/btn_icon"
                android:src="@drawable/ic_refresh"
                android:scaleType="centerInside"
                android:tint="@color/text"
                android:contentDescription="@string/refresh" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/ratesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
