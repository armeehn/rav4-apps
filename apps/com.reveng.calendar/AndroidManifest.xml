<?xml version="1.0" encoding="utf-8"?>
<!-- Clean-room standalone Calendar app for the Toyota RAV4 GT6 head unit.
     Standalone normal app: no sharedUserId, no platform signing.
     Reads device calendar events via ContentResolver (CalendarContract)
     under a runtime READ_CALENDAR grant. Pure android.*, no AndroidX. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.reveng.calendar"
    android:versionCode="1"
    android:versionName="1.0-reveng">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="33" />

    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="com.reveng.calendar.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
