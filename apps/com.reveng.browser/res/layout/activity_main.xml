<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- ===== Top toolbar over the surface color ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/backBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/btn_icon"
            android:src="@drawable/ic_back"
            android:scaleType="centerInside"
            android:contentDescription="@string/back" />

        <ImageButton
            android:id="@+id/forwardBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/btn_icon"
            android:src="@drawable/ic_forward"
            android:scaleType="centerInside"
            android:contentDescription="@string/forward" />

        <ImageButton
            android:id="@+id/refreshBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/btn_icon"
            android:src="@drawable/ic_refresh"
            android:scaleType="centerInside"
            android:contentDescription="@string/refresh" />

        <ImageButton
            android:id="@+id/homeBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/btn_icon"
            android:src="@drawable/ic_home"
            android:scaleType="centerInside"
            android:contentDescription="@string/home" />

        <!-- Address bar -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_globe"
                android:tint="@color/text3" />

            <EditText
                android:id="@+id/addressInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_field"
                android:paddingLeft="44dp"
                android:paddingRight="16dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text3"
                android:textSize="16sp"
                android:inputType="textUri"
                android:imeOptions="actionGo"
                android:maxLines="1"
                android:selectAllOnFocus="true"
                android:hint="@string/hint_address" />
        </FrameLayout>
    </LinearLayout>

    <!-- Thin accent progress bar -->
    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/accent"
        android:progressBackgroundTint="@color/surface"
        android:visibility="gone" />

    <!-- ===== Content: WebView + home overlay ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ScrollView
            android:id="@+id/homeView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="32dp">

                <TextView
                    style="@style/Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textSize="44sp"
                    android:text="@string/home_title" />

                <TextView
                    style="@style/Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/home_subtitle" />

                <!-- Quick-link grid is populated in code -->
                <GridLayout
                    android:id="@+id/quickGrid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:columnCount="6" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
