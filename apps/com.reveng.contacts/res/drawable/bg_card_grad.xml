<?xml version="1.0" encoding="utf-8"?>
<!-- v0.8 Riposte: the hero card. Same hard-edge chrome as bg_card (the gradient is
     gone — it also never followed the launcher palette) plus the 6dp accent top bar. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/shadow" />
        </shape>
    </item>
    <item android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface2" />
            <stroke android:width="2dp" android:color="@color/stroke" />
        </shape>
    </item>
    <item android:right="4dp" android:height="6dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
        </shape>
    </item>
</layer-list>
