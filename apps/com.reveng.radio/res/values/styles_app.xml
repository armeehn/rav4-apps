<?xml version="1.0" encoding="utf-8"?>
<!-- Radio-only styles, kept out of styles.xml so that file stays a byte-identical copy
     of the shared pack (scope/sync-design.sh overwrites it). -->
<resources>
    <!-- Band tab (FM / AM / NET segmented control) -->
    <style name="Tab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingLeft">26dp</item>
        <item name="android:paddingRight">26dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/text2</item>
        <item name="android:gravity">center</item>
    </style>
    <!-- Tuner transport control button -->
    <style name="Ctl">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">6dp</item>
        <item name="android:layout_marginRight">6dp</item>
        <item name="android:paddingLeft">22dp</item>
        <item name="android:paddingRight">22dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:background">@drawable/bg_ctl</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
