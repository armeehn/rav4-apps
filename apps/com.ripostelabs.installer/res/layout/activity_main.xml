<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Header row: title + tab switch + refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/H1"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                style="@style/Caption"
                android:text="" />
        </LinearLayout>

        <!-- Tab switch (button row swapping views) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginRight="12dp">

            <Button
                android:id="@+id/tab_install"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:minWidth="120dp"
                android:background="@drawable/btn_accent"
                android:textColor="#FFFFFFFF"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tab_install" />

            <Button
                android:id="@+id/tab_apps"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:minWidth="120dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/btn_ghost"
                android:textColor="@color/text2"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tab_apps" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/btn_icon"
            android:src="@drawable/ic_add"
            android:tint="@color/text"
            android:scaleType="fitCenter"
            android:padding="14dp"
            android:contentDescription="@string/refresh" />
    </LinearLayout>

    <!-- Section label -->
    <TextView
        android:id="@+id/section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginBottom="6dp"
        style="@style/Overline"
        android:text="@string/section_available" />

    <!-- List area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/apk_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbarStyle="outsideOverlay"
            android:clipToPadding="false"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp" />

        <ListView
            android:id="@+id/app_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbarStyle="outsideOverlay"
            android:clipToPadding="false"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone" />

        <!-- Empty / permission state: the shared shape (styles.xml EmptyState*), ids stay ours. -->
        <LinearLayout
            android:id="@+id/empty"
            style="@style/EmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/empty_icon"
                style="@style/EmptyStateIcon"
                android:src="@drawable/ic_download" />
            <TextView
                android:id="@+id/empty_text"
                style="@style/EmptyStateTitle"
                android:text="@string/empty_no_apks" />
            <TextView
                android:id="@+id/empty_hint"
                style="@style/EmptyStateHint"
                android:text="@string/empty_apks_hint" />
            <Button
                android:id="@+id/grant"
                style="@style/EmptyStateAction"
                android:text="@string/grant" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
