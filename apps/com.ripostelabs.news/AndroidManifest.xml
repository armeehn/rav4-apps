<?xml version="1.0" encoding="utf-8"?>
<!-- Clean-room standalone News (RSS reader) app for the RAV4 GT6 head unit.
     Standalone normal app: new package, no sharedUserId, no system/privileged
     permissions. Plain android.* only, no AndroidX or Gradle. Reads public
     RSS/Atom feeds over HTTP and renders headlines; taps open an in-app WebView. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ripostelabs.news"
    android:versionCode="1"
    android:versionName="1.0-riposte">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="33" />


    <!-- The launcher's theme provider (see com.ripostelabs.design.Palette). Without this an app
         targeting API 30+ cannot see the provider at all: the query returns null and the app
         silently keeps its built-in palette. Declaring the authority is the whole grant. -->
    <queries>
        <provider android:authorities="com.ripostelabs.carlauncher.theme" />
    </queries>
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="com.ripostelabs.news.NewsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.ripostelabs.news.ReaderActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
