<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg"
    android:padding="20dp">

    <!-- ===== LEFT (~55%): analog gauge + overlays ===== -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="55">

        <!-- The custom Canvas gauge fills the area; it draws the dial, needle,
             big digital readout and unit. -->
        <com.ripostelabs.speedometer.GaugeView
            android:id="@+id/gauge"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Header overlay: icon + title (top-left), unit toggle (top-right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_speed"
                android:tint="@color/accent" />

            <TextView
                style="@style/Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/status"
                style="@style/Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:textColor="@color/text3"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/waiting" />

            <Button
                android:id="@+id/unitBtn"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:minWidth="96dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@drawable/btn_ghost"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="false"
                android:text="km/h" />
        </LinearLayout>

        <!-- Center digital readout: huge speed (@style/Display) + unit below -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/bigSpeed"
                style="@style/Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="128sp"
                android:text="0" />

            <TextView
                android:id="@+id/bigUnit"
                style="@style/Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text2"
                android:textSize="16sp"
                android:text="km/h" />
        </LinearLayout>

        <!-- Permission / GPS-off fallback overlay (shown only when needed) -->
        <LinearLayout
            android:id="@+id/noticeBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/scrim"
            android:visibility="gone">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_location"
                android:tint="@color/accent" />

            <TextView
                android:id="@+id/noticeTitle"
                style="@style/H1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/perm_needed" />

            <TextView
                android:id="@+id/noticeHint"
                style="@style/Caption"
                android:layout_width="360dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/perm_hint" />

            <Button
                android:id="@+id/noticeBtn"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:background="@drawable/btn_ghost"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="false"
                android:text="@string/open_settings" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===== RIGHT (~45%): trip stats ===== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="45"
        android:layout_marginStart="20dp"
        android:orientation="vertical">

        <!-- header row: TRIP + reset -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_navigation"
                android:tint="@color/accent" />

            <TextView
                style="@style/Overline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/trip_title" />

            <Button
                android:id="@+id/resetBtn"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:drawableStart="@drawable/ic_refresh"
                android:drawablePadding="8dp"
                android:background="@drawable/btn_ghost"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="false"
                android:text="@string/reset" />
        </LinearLayout>

        <!-- row 1: distance | max -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp">

                <TextView style="@style/Overline"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/distance" />
                <TextView android:id="@+id/statDistance" style="@style/H1"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:textSize="30sp" android:text="0.00 km" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp">

                <TextView style="@style/Overline"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/max_speed" />
                <TextView android:id="@+id/statMax" style="@style/H1"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:textSize="30sp" android:text="0 km/h" />
            </LinearLayout>
        </LinearLayout>

        <!-- row 2: avg | heading -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp">

                <TextView style="@style/Overline"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/avg_speed" />
                <TextView android:id="@+id/statAvg" style="@style/H1"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:textSize="30sp" android:text="0 km/h" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp">

                <TextView style="@style/Overline"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/heading" />
                <TextView android:id="@+id/statHeading" style="@style/H1"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:textSize="30sp" android:text="—" />
            </LinearLayout>
        </LinearLayout>

        <!-- row 3: elapsed (full width) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <TextView style="@style/Overline"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/elapsed" />
            <TextView android:id="@+id/statElapsed" style="@style/H1"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textSize="30sp"
                android:fontFamily="monospace" android:text="00:00:00" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
