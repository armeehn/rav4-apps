<?xml version="1.0" encoding="utf-8"?>
<!-- v0.8 Riposte: the FAB is a hard-edged accent square over the drawn offset shadow. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <layer-list>
            <item android:left="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/shadow" />
                </shape>
            </item>
            <item android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
